# ─── Database ────────────────────────────────────────────────────
# DATABASE_URL="mysql://user:password@host:3306/coledia"

# ─── Tenant ──────────────────────────────────────────────────────
# Each Dokploy container has its own TENANT_ID.
# This tells the app which tenant it's serving.
TENANT_ID=""

# ─── Better-Auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3100"
# Email verification after sign-up is a per-tenant setting
# (Admin → Settings → Sign-up & Verification), not an env var.

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3100"
# External Controlcenter — plan upgrades and billing history are managed there.
CONTROL_CENTER_URL="https://controlcenter.coledia.com"

# ─── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="hello@coledia.com"

# ─── Internal API (Controlcenter → App) ──────────────────────────
# Shared secret for /api/internal/* (tenant seeding & sync from the Controlcenter).
# Must match the Controlcenter's APP_INTERNAL_API_SECRET.
INTERNAL_API_SECRET=""

# ─── File Storage ─────────────────────────────────────────────────
# Local filesystem path for uploaded files (documents, images, avatars, videos).
# IMPORTANT: the container filesystem is wiped on every Dokploy redeploy.
# In production set this to an ABSOLUTE path backed by a Dokploy BIND MOUNT
# (Dokploy → app → Advanced → Mounts → Bind Mount, host path e.g.
# /srv/coledia/<tenant>/uploads → container path /data/uploads). Avoid named
# "Volume Mounts": Docker cleanups (docker volume prune --all) can delete them
# while the container is stopped during a redeploy. GET /api/health returns 503
# when this path is not on a mount (use it as the Dokploy healthcheck). Relative paths resolve against the
# app working directory.
STORAGE_PATH="./uploads"
# STORAGE_PATH="/data/uploads"   # production, with a Dokploy volume mounted here
