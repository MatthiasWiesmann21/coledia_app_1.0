// Coledia — Multi-tenant Club LMS
// Single shared MySQL database. Every tenant-scoped table has tenantId.
// Isolation enforced via tenantScoped() Prisma extension (see src/tenant.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Tenant & branding ───────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  subdomain      String   @unique
  customDomain   String?  @unique
  name           String
  status         String   @default("active") // active | suspended | cancelled | trialing
  plan           String   @default("starter") // starter | club | organization
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branding       Branding?
  memberships    Membership[]
  userGroups     UserGroup[]
  categories     Category[]
  courses        Course[]
  posts          Post[]
  events         Event[]
  documents      Document[]
  folders        Folder[]
  chatServers    ChatServer[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  subscriptions  Subscription[]
  payments       Payment[]

  @@index([status])
}

model Branding {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Container settings
  logoLightUrl  String?
  logoDarkUrl   String?
  logoClickUrl  String?
  faviconUrl    String?

  // Design — theme / button
  primaryColorLight  String?
  primaryColorDark   String?

  // Design — navigation
  navTextColorLight  String?
  navTextColorDark   String?
  navBgColorLight    String?
  navBgColorDark     String?

  // Design — auth page logos
  authLogoSignUpLight   String?
  authLogoSignUpDark    String?
  authLogoSignInLight   String?
  authLogoSignInDark    String?
  authLogoForgotLight   String?
  authLogoForgotDark    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Users & memberships ─────────────────────────────────────────
// User model is managed by Better-Auth. We extend with a UserProfile.

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  // Better-Auth fields
  passwordHash  String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       UserProfile?
  memberships   Membership[]
  enrollments   Enrollment[]
  chapterProgress ChapterProgress[]
  comments      Comment[]
  eventRegistrations EventRegistration[]
  certificates  Certificate[]
  likes         Like[]
  favourites    Favourite[]
  messages      Message[]
  directConversations1 DirectConversation[] @relation("directUser1")
  directConversations2 DirectConversation[] @relation("directUser2")
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  coursePurchases CoursePurchase[]
  chatServerMembers ChatServerMember[]
  channelMembers   ChannelMember[]
  userGroupMembers UserGroupMember[]
  auditLogs    AuditLog[]
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String?
  bio             String?  @db.Text
  avatarUrl       String?
  status          String   @default("online") // online | not_available | do_not_disturb | invisible
  acceptedTermsAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("member") // owner | admin | operator | member
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// ─── User groups (access control) ────────────────────────────────

model UserGroup {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   UserGroupMember[]
  courses   Course[]
  events    Event[]

  @@index([tenantId])
}

model UserGroupMember {
  id           String    @id @default(cuid())
  userGroupId  String
  userId       String
  userGroup    UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt      DateTime  @default(now())

  @@unique([userGroupId, userId])
}

// ─── Categories (shared across modules) ──────────────────────────

model Category {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  isCourse       Boolean  @default(false)
  isNews         Boolean  @default(false)
  isEvent        Boolean  @default(false)
  color          String   @default("#008080")
  textColorLight String   @default("#0c2340")
  textColorDark  String   @default("#f4f6f8")
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses        Course[]
  posts          Post[]
  events         Event[]

  @@index([tenantId])
}

// ─── Courses ─────────────────────────────────────────────────────

model Course {
  id               String   @id @default(cuid())
  tenantId         String
  title            String
  description      String?  @db.Text
  thumbnailUrl     String?
  categoryId       String?
  userGroupId      String?
  duration         String?
  level            String?  // beginner | intermediate | advanced
  specialStatus    String?  // featured | trending | exclusive
  price            Decimal? @db.Decimal(10, 2)
  attachments      Json?    // array of {name, url, type}
  published        Boolean  @default(false)
  dripConfig       Json?    // {enabled, intervalDays, intervalType}
  prerequisiteCourseIds Json? // array of course IDs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category? @relation(fields: [categoryId], references: [id])
  userGroup        UserGroup? @relation(fields: [userGroupId], references: [id])
  chapters         Chapter[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  coursePurchases  CoursePurchase[]

  @@index([tenantId])
  @@index([tenantId, published])
}

model Chapter {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?  @db.Text
  duration    String?
  level       String?
  author      String?
  videoUrl    String?
  videoType   String?  // youtube | vimeo | upload | external
  accessFree  Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    ChapterProgress[]
  comments    Comment[]
  quizzes     Quiz[]

  @@index([courseId])
  @@index([courseId, published])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progressPct Float     @default(0)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model ChapterProgress {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Quiz {
  id            String   @id @default(cuid())
  chapterId     String
  questions     Json     // array of {id, type, question, options[], correctAnswer, points}
  passingScore  Int      @default(70)
  attemptLimit  Int?
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attempts      QuizAttempt[]

  @@index([chapterId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean
  answers     Json
  attemptedAt DateTime  @default(now())
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}

model Certificate {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  certificateUrl String?
  issuedAt       DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ─── News / Community feed ───────────────────────────────────────

model Post {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?   @db.Text
  categoryId  String?
  imageUrl    String?
  gifUrl      String?
  published   Boolean   @default(false)
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
  comments    Comment[]

  @@index([tenantId, published])
  @@index([tenantId, scheduledAt])
}

model Comment {
  id          String   @id @default(cuid())
  tenantId    String
  postId      String?
  chapterId   String?
  userId      String
  content     String   @db.Text
  parentId    String?  // nested replies
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  chapter     Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[] @relation("CommentReplies")

  @@index([tenantId])
  @@index([postId])
  @@index([chapterId])
  @@index([parentId])
}

// ─── Likes & Favourites (polymorphic) ────────────────────────────

model Like {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  targetType  String   // chapter | post | event | comment
  targetId    String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([tenantId, targetType])
}

model Favourite {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  targetType  String   // chapter | course | post | event
  targetId    String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([tenantId, targetType])
}

// ─── Live events ─────────────────────────────────────────────────

model Event {
  id                String    @id @default(cuid())
  tenantId          String
  title             String
  description       String?   @db.Text
  thumbnailUrl      String?
  categoryId        String?
  userGroupId       String?
  startAt           DateTime
  endAt             DateTime?
  videoUrl          String?
  videoType         String?   // youtube | vimeo | upload | external
  streamChatEnabled Boolean   @default(true)
  published         Boolean   @default(false)
  recurrenceRule    String?   // RRULE string for recurring events
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id])
  userGroup         UserGroup? @relation(fields: [userGroupId], references: [id])
  registrations     EventRegistration[]

  @@index([tenantId, published])
  @@index([tenantId, startAt])
}

model EventRegistration {
  id           String    @id @default(cuid())
  userId       String
  eventId      String
  registeredAt DateTime  @default(now())
  attendedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

// ─── Documents (deferred — models kept for future implementation) ─

model Folder {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  parentId   String?
  visible    Boolean  @default(true)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Folder[] @relation("FolderTree")
  documents  Document[]

  @@index([tenantId])
  @@index([parentId])
}

model Document {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  folderId   String?
  fileUrl    String?
  fileSize   Int?
  fileType   String?
  visible    Boolean  @default(true)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder     Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]

  @@index([tenantId])
  @@index([folderId])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  fileUrl     String
  uploadedBy  String?
  uploadedAt  DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ─── Chat (text channels + DMs only) ─────────────────────────────

model ChatServer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channels    Channel[]
  members     ChatServerMember[]

  @@index([tenantId])
}

model Channel {
  id           String   @id @default(cuid())
  chatServerId String
  name         String
  type         String   @default("text") // text only for now
  permissions  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chatServer   ChatServer @relation(fields: [chatServerId], references: [id], onDelete: Cascade)
  members      ChannelMember[]
  messages     Message[]

  @@index([chatServerId])
}

model ChatServerMember {
  id           String     @id @default(cuid())
  userId       String
  chatServerId String
  role         String     @default("member") // admin | operator | member
  joinedAt     DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatServer   ChatServer @relation(fields: [chatServerId], references: [id], onDelete: Cascade)

  @@unique([userId, chatServerId])
}

model ChannelMember {
  id        String   @id @default(cuid())
  userId    String
  channelId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id           String   @id @default(cuid())
  channelId    String?
  directConversationId String?
  userId       String
  content      String   @db.Text
  attachments  Json?    // array of {name, url, type}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  channel      Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  directConversation DirectConversation? @relation(fields: [directConversationId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([directConversationId, createdAt])
}

model DirectConversation {
  id       String   @id @default(cuid())
  tenantId String
  user1Id  String
  user2Id  String
  createdAt DateTime @default(now())
  user1   User     @relation("directUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2   User     @relation("directUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
}

// ─── Notifications ───────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  type      String   // new_post | event_reminder | chat_mention | direct_message | course_update | member_joined
  title     String
  body      String?  @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([tenantId])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  type      String   // notification type
  channel   String   // in_app | email | push
  enabled   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
}

// ─── Billing ─────────────────────────────────────────────────────

model Subscription {
  id                    String    @id @default(cuid())
  tenantId              String
  stripeSubscriptionId  String?   @unique
  plan                  String    @default("starter")
  status                String    @default("active") // active | canceled | past_due | trialing
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Payment {
  id                    String    @id @default(cuid())
  tenantId              String
  stripePaymentIntentId String?   @unique
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("chf")
  status                String    @default("pending") // pending | succeeded | failed | refunded
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coursePurchases       CoursePurchase[]

  @@index([tenantId])
}

model CoursePurchase {
  id                    String    @id @default(cuid())
  userId                String
  courseId              String
  paymentId             String?
  stripePaymentIntentId String?
  amount                Decimal   @db.Decimal(10, 2)
  status                String    @default("pending") // pending | succeeded | failed | refunded
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment               Payment?  @relation(fields: [paymentId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
}

// ─── Audit log ───────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String   // create | update | delete | invite | etc.
  entityType String   // course | post | event | member | settings | etc.
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ─── API & Webhooks (Organization tier) ──────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  scopes     Json?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  events    Json     // array of event types
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
