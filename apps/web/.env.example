# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@host:3306/coledia"

# ─── Tenant ──────────────────────────────────────────────────────
# Each Dokploy container has its own TENANT_ID.
# This tells the app which tenant it's serving.
TENANT_ID=""

# ─── Better-Auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── File Storage (S3-compatible, e.g. MinIO) ────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="coledia"
S3_REGION="us-east-1"

# ─── Email (SMTP) ────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="hello@coledia.com"

# ─── Realtime (Socket.io) ────────────────────────────────────────
REALTIME_URL="http://localhost:3001"
